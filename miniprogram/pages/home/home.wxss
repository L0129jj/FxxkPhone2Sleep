.page {
  min-height: 100vh;
  background: radial-gradient(130% 62% at 50% 0%, #ffffff 0%, #f9f7f3 42%, #f3f1ea 100%);
}

/* ---------- 自定义导航 ---------- */
.nav {
  width: 100%;
}
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: -0.01em;
}

/* ---------- 加载 / 失败态 ---------- */
.state-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 220rpx 60rpx 0;
}
.state-title {
  font-size: 34rpx;
  font-weight: 650;
  margin-bottom: 14rpx;
}
.state-text {
  font-size: 26rpx;
  color: #8b8982;
  line-height: 1.7;
  text-align: center;
}
.retry-btn {
  margin-top: 40rpx;
  padding: 20rpx 64rpx;
  border-radius: 24rpx;
  background: #161615;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
}

.press {
  transform: scale(0.98);
  opacity: 0.9;
}

/* ---------- 内容 ---------- */
.scroll {
  padding: 8rpx 44rpx 40rpx;
}

.date-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #8b8982;
}
.date-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #f43b2f;
  box-shadow: 0 0 0 6rpx rgba(244, 59, 47, 0.12);
}

.home-title {
  display: flex;
  flex-direction: column;
  font-size: 58rpx;
  line-height: 1.28;
  letter-spacing: -0.035em;
  font-weight: 700;
  margin: 22rpx 0 10rpx;
}
.tagline {
  font-size: 24rpx;
  color: #a9a69e;
  margin-bottom: 20rpx;
}

.period-pill {
  display: inline-flex;
  align-self: flex-start;
  flex-wrap: wrap;
  align-items: center;
  gap: 4rpx;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(22, 22, 21, 0.07);
  font-size: 22rpx;
  color: #45443f;
  box-shadow: 0 8rpx 24rpx -16rpx rgba(0, 0, 0, 0.2);
}
.period-pill .strong {
  font-weight: 600;
  color: #161615;
}

/* ---------- 大按钮 ---------- */
.toggle-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 44rpx 0 40rpx;
}
.big-toggle {
  width: 420rpx;
  height: 420rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: background 0.32s ease, box-shadow 0.32s ease;
}
.big-toggle.is-red {
  background: radial-gradient(120% 120% at 30% 18%, #ff7a6e 0%, #f94a3d 38%, #e52c1f 72%, #c71e13 100%);
  box-shadow: 0 54rpx 100rpx -40rpx rgba(217, 43, 32, 0.72);
}
.big-toggle.is-green {
  background: radial-gradient(120% 120% at 30% 18%, #4fd68c 0%, #22b96b 38%, #129c55 72%, #0b7e42 100%);
  box-shadow: 0 54rpx 100rpx -40rpx rgba(13, 131, 69, 0.6);
}
.big-hint {
  font-size: 20rpx;
  letter-spacing: 0.16em;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  color: rgba(255, 255, 255, 0.86);
  margin-bottom: 18rpx;
}
.big-main {
  font-size: 126rpx;
  line-height: 1;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: -0.04em;
}
.big-sub {
  font-size: 24rpx;
  letter-spacing: 0.12em;
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.9);
}

.toggle-state {
  font-size: 22rpx;
  line-height: 1.6;
  color: #8b8982;
  margin-top: 28rpx;
  text-align: center;
  max-width: 560rpx;
}
.toggle-state.warn {
  color: #c47a09;
}

/* ---------- 时间卡片 ---------- */
.time-grid {
  display: flex;
  gap: 20rpx;
  margin-top: 8rpx;
}
.time-card {
  position: relative;
  flex: 1;
  text-align: left;
  background: #ffffff;
  border: 1rpx solid rgba(22, 22, 21, 0.08);
  border-radius: 32rpx;
  padding: 26rpx 26rpx 24rpx;
  box-shadow: 0 20rpx 46rpx -42rpx rgba(22, 22, 21, 0.5);
}
.tc-top {
  display: block;
  color: #8b8982;
  font-size: 22rpx;
}
.tc-value {
  display: block;
  font-size: 44rpx;
  font-weight: 650;
  letter-spacing: -0.02em;
  margin-top: 16rpx;
  line-height: 1.15;
}
.tc-value.empty {
  color: #a9a69e;
  font-size: 34rpx;
  font-weight: 500;
}
.tc-hint {
  display: block;
  font-size: 20rpx;
  color: #a9a69e;
  margin-top: 8rpx;
}
.mini-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  font-size: 19rpx;
  font-weight: 600;
  color: #3c64d8;
  background: #eef3ff;
  border-radius: 999rpx;
  padding: 6rpx 14rpx;
}

/* ---------- 结果横幅 ---------- */
.result-banner {
  margin-top: 22rpx;
  border-radius: 30rpx;
  padding: 22rpx 26rpx;
}
.result-banner .rb-title {
  display: block;
  font-size: 25rpx;
  font-weight: 650;
  line-height: 1.4;
}
.result-banner .rb-desc {
  display: block;
  font-size: 21rpx;
  line-height: 1.6;
  margin-top: 4rpx;
  opacity: 0.8;
}
.result-banner.pending {
  background: #edf2ff;
  color: #294c9e;
}
.result-banner.ok {
  background: #e8f7ee;
  color: #096c39;
}
.result-banner.bad {
  background: #fff4e5;
  color: #935b07;
}

/* ---------- 行卡片 ---------- */
.row-card {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #ffffff;
  border: 1rpx solid rgba(22, 22, 21, 0.08);
  border-radius: 32rpx;
  padding: 26rpx 28rpx;
  margin-top: 20rpx;
  box-shadow: 0 20rpx 46rpx -42rpx rgba(22, 22, 21, 0.5);
}
.row-main {
  flex: 1;
  min-width: 0;
}
.row-title {
  display: block;
  font-size: 25rpx;
  font-weight: 600;
}
.row-sub {
  display: block;
  font-size: 21rpx;
  color: #8b8982;
  margin-top: 4rpx;
}
.row-value {
  font-size: 25rpx;
  font-weight: 600;
  color: #45443f;
}
.chevron {
  font-size: 34rpx;
  color: #a9a69e;
}

/* ---------- 周报快捷卡片 ---------- */
.report-card {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 26rpx;
  margin-top: 20rpx;
  padding: 30rpx 32rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #1e1e1c, #111110);
  color: #ffffff;
  box-shadow: 0 34rpx 64rpx -46rpx rgba(0, 0, 0, 0.8);
}
.report-main {
  flex: 1;
  min-width: 0;
}
.report-label {
  display: block;
  font-size: 20rpx;
  letter-spacing: 0.1em;
  color: rgba(255, 255, 255, 0.55);
}
.report-value {
  font-size: 36rpx;
  font-weight: 650;
  margin-top: 10rpx;
}
.report-value .em {
  color: #6ee7a5;
  font-size: 44rpx;
  margin: 0 4rpx;
}
.report-sub {
  display: block;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.45);
  margin-top: 6rpx;
}
.report-arrow {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}
.report-arrow .arrow {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* ---------- 底部提示 ---------- */
.deadline-note {
  font-size: 20rpx;
  line-height: 1.7;
  color: #a9a69e;
  margin: 30rpx 8rpx 10rpx;
  text-align: center;
  white-space: pre-line;
}

/* ---------- 数据管理入口 ---------- */
.data-entry {
  margin: 6rpx auto 0;
  padding: 16rpx 28rpx;
  font-size: 21rpx;
  color: #8b8982;
  text-align: center;
  border-radius: 999rpx;
}
.data-entry.disabled {
  color: #c2bfb8;
}
