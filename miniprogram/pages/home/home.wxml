<view class="page theme-{{theme}}">
  <!-- 自定义导航（左侧主题切换，右侧避让胶囊） -->
  <view class="nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-bar" style="height: {{navHeight}}px;">
      <view
        class="theme-btn"
        hover-class="press"
        bindtap="onToggleTheme"
        aria-role="button"
        aria-label="{{theme === 'dark' ? '切换到浅色模式' : '切换到深色模式'}}"
      >
        <view class="ic ic-sun" wx:if="{{theme === 'dark'}}">
          <view class="sun-ray h"></view>
          <view class="sun-ray v"></view>
          <view class="sun-core"></view>
        </view>
        <view class="ic ic-moon" wx:else>
          <view class="moon-disc"></view>
        </view>
      </view>
      <text class="nav-title">睡前记录</text>
    </view>
  </view>

  <!-- 加载中 -->
  <view class="state-wrap" wx:if="{{loading}}">
    <text class="state-text">正在读取……</text>
  </view>

  <!-- 读取失败：不伪装成空数据，提供重试 -->
  <view class="state-wrap" wx:elif="{{loadFailed}}">
    <text class="state-title">读取失败</text>
    <text class="state-text">{{loadErrorMsg}}</text>
    <view class="retry-btn" hover-class="press" bindtap="onRetry">重试</view>
  </view>

  <!-- 正常内容 -->
  <block wx:else>
    <view class="scroll">
      <view class="hero">
        <view class="date-line">
          <view class="date-dot"></view>
          <text>{{todayText}}</text>
        </view>
        <text class="home-title">今晚，你刷手机了吗？</text>
        <view class="meta-line">
          <text>记录 </text>
          <text class="strong">{{periodDateText}}</text>
          <text> 这一晚 · 截止 {{deadlineText}}</text>
        </view>
      </view>

      <!-- 核心动作：这一晚唯一的大按钮 -->
      <view class="dial-wrap">
        <view
          class="dial {{pendingPhone ? 'is-yes' : 'is-no'}}"
          hover-class="dial-press"
          bindtap="onTogglePhone"
          aria-role="button"
          aria-label="{{pendingPhone ? '今晚刷了手机，点击切换为没刷手机' : '今晚没刷手机，点击切换为刷了手机'}}"
        >
          <view class="dial-orbit"></view>
          <text class="dial-hint">点击切换</text>
          <text class="dial-main">{{pendingPhone ? '是' : '否'}}</text>
          <text class="dial-sub">{{pendingPhone ? '忍不住刷了手机' : '没刷手机'}}</text>
        </view>
      </view>
      <text class="dial-status {{statusWarn ? 'warn' : ''}}">{{statusText}}</text>

      <!-- 入睡 / 起床 -->
      <view class="time-row">
        <view class="tf" hover-class="press" bindtap="openSleepSheet" aria-role="button" aria-label="填写准备入睡时间">
          <view class="tf-label">
            <view class="tf-dot sleep"></view>
            <text>入睡</text>
          </view>
          <text class="tf-val" wx:if="{{sleepText}}">{{sleepText}}</text>
          <text class="tf-val empty" wx:else>＋ 添加</text>
          <text class="tf-hint">{{sleepText ? '点击修改' : '准备入睡时间'}}</text>
        </view>
        <view class="tf-div"></view>
        <view class="tf" hover-class="press" bindtap="openWakeSheet" aria-role="button" aria-label="填写起床时间">
          <view class="tf-label">
            <view class="tf-dot wake"></view>
            <text>起床</text>
            <text class="tf-badge" wx:if="{{sleepText && !wakeText}}">待补</text>
          </view>
          <text class="tf-val" wx:if="{{wakeText}}">{{wakeText}}</text>
          <text class="tf-val empty" wx:else>＋ 添加</text>
          <text class="tf-hint">{{wakeText ? '点击修改' : '次日 12:00 前补'}}</text>
        </view>
      </view>

      <!-- 服务端判定结果 -->
      <view class="result-banner {{banner.cls}}" wx:if="{{banner.show}}">
        <text class="rb-title">{{banner.title}}</text>
        <text class="rb-desc">{{banner.desc}}</text>
      </view>

      <!-- 本周进度 -->
      <view class="week-card" hover-class="press" bindtap="goReport" aria-role="button" aria-label="查看本周周报">
        <view class="week-head">
          <text class="wk-label">本周进度</text>
          <text class="wk-sub" wx:if="{{weekCardVisible}}">完整打卡 {{weekCompleteCount}} 天</text>
        </view>
        <view class="week-main" wx:if="{{weekCardVisible}}">
          <view class="wk-num">
            <text class="wk-met">{{weekMetCount}}</text>
            <text class="wk-total">/7</text>
            <text class="wk-unit">天达标</text>
          </view>
          <view class="chev">›</view>
        </view>
        <view class="week-main" wx:else>
          <text class="wk-fallback">查看每日结果</text>
          <view class="chev">›</view>
        </view>
        <view class="segs" wx:if="{{weekCardVisible}}">
          <view class="seg {{item.on ? 'on' : ''}}" wx:for="{{weekSegs}}" wx:key="i"></view>
        </view>
      </view>

      <!-- 目标入口 -->
      <view class="goal-row" hover-class="press" bindtap="openTargetSheet" aria-role="button" aria-label="设置目标就寝时间">
        <view class="goal-clock"></view>
        <view class="goal-main">
          <text class="goal-title">就寝目标</text>
          <text class="goal-sub">{{targetSubText}}</text>
        </view>
        <text class="goal-value">{{targetValueText}}</text>
        <text class="goal-arrow">›</text>
      </view>

      <view class="deadline-note">
        <text>请于{{deadlineDayWord}} 12:00 前补齐起床时间，逾期后本晚只读。</text>
        <text>记录时间由你自己填写，仅用于习惯回顾，不是睡眠监测。</text>
      </view>

      <view class="data-entry {{clearing ? 'disabled' : ''}}" hover-class="press" bindtap="onClearData">
        <text>{{clearing ? '正在清空……' : '清空我的全部数据'}}</text>
      </view>
      <view class="safe-bottom"></view>
    </view>
  </block>
</view>

<!-- C-01 几点睡选择器 -->
<time-picker-sheet
  theme="{{theme}}"
  data-sheet="sleepSheet"
  visible="{{sleepSheet.visible}}"
  submitting="{{sleepSheet.submitting}}"
  errorText="{{sleepSheet.errorText}}"
  title="{{sleepSheet.title}}"
  desc="{{sleepSheet.desc}}"
  hint="{{sleepSheet.hint}}"
  day0Label="{{sleepSheet.day0Label}}"
  day1Label="{{sleepSheet.day1Label}}"
  seg1Disabled="{{sleepSheet.seg1Disabled}}"
  initialSeg="{{sleepSheet.initialSeg}}"
  initialTime="{{sleepSheet.initialTime}}"
  bind:confirm="onSleepConfirm"
  bind:cancel="onSheetCancel"
/>

<!-- C-01 几点起选择器 -->
<time-picker-sheet
  theme="{{theme}}"
  data-sheet="wakeSheet"
  visible="{{wakeSheet.visible}}"
  submitting="{{wakeSheet.submitting}}"
  errorText="{{wakeSheet.errorText}}"
  title="{{wakeSheet.title}}"
  desc="{{wakeSheet.desc}}"
  hint="{{wakeSheet.hint}}"
  day0Label="{{wakeSheet.day0Label}}"
  day1Label="{{wakeSheet.day1Label}}"
  seg1Disabled="{{wakeSheet.seg1Disabled}}"
  initialSeg="{{wakeSheet.initialSeg}}"
  initialTime="{{wakeSheet.initialTime}}"
  bind:confirm="onWakeConfirm"
  bind:cancel="onSheetCancel"
/>

<!-- C-02 目标设置 -->
<target-sheet
  theme="{{theme}}"
  data-sheet="targetSheet"
  visible="{{targetSheet.visible}}"
  submitting="{{targetSheet.submitting}}"
  errorText="{{targetSheet.errorText}}"
  initialEnabled="{{targetSheet.initialEnabled}}"
  initialTime="{{targetSheet.initialTime}}"
  tonightSubmitted="{{targetSheet.tonightSubmitted}}"
  tonightTargetText="{{targetSheet.tonightTargetText}}"
  nextTargetText="{{targetSheet.nextTargetText}}"
  nextDateText="{{targetSheet.nextDateText}}"
  isFirstSetting="{{targetSheet.isFirstSetting}}"
  bind:save="onTargetSave"
  bind:cancel="onSheetCancel"
/>
