.page {
  min-height: 100vh;
  background: var(--page-bg);
  background-attachment: fixed;
  color: var(--text);
}

/* ---------- 自定义导航 ---------- */
.nav {
  width: 100%;
}
.nav-bar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}
.nav-back {
  position: absolute;
  left: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-back:active {
  background: var(--chip);
}
.back-arrow {
  font-size: 44rpx;
  line-height: 1;
  color: var(--text);
  margin-top: -6rpx;
}

.press {
  opacity: 0.8;
}

/* ---------- 加载 / 失败态 ---------- */
.state-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 220rpx 60rpx 0;
}
.state-title {
  font-size: 34rpx;
  font-weight: 650;
  margin-bottom: 14rpx;
  color: var(--text);
}
.state-text {
  font-size: 26rpx;
  color: var(--text-3);
  line-height: 1.7;
  text-align: center;
}
.retry-btn {
  margin-top: 40rpx;
  padding: 20rpx 64rpx;
  border-radius: 24rpx;
  background: var(--btn-primary-bg);
  color: var(--btn-primary-ink);
  font-size: 28rpx;
  font-weight: 600;
}

/* ---------- 内容 ---------- */
.scroll {
  padding: 8rpx 40rpx 40rpx;
}

/* 周切换 */
.week-switch {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--card);
  border: 1rpx solid var(--card-line);
  border-radius: 30rpx;
  padding: 16rpx 20rpx;
}
.ws-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ws-btn.dis {
  opacity: 0.3;
}
.ws-arrow {
  font-size: 40rpx;
  line-height: 1;
  color: var(--text-2);
  margin-top: -6rpx;
}
.ws-center {
  text-align: center;
}
.ws-range {
  display: block;
  font-size: 25rpx;
  font-weight: 600;
  color: var(--text);
}
.ws-label {
  display: block;
  font-size: 19rpx;
  color: var(--text-3);
  margin-top: 4rpx;
  letter-spacing: 0.08em;
}

/* 汇总卡片 */
.summary-card {
  margin-top: 20rpx;
  border-radius: 40rpx;
  padding: 36rpx 34rpx 28rpx;
  background: var(--card);
  border: 1rpx solid var(--card-line);
  box-shadow: var(--card-shadow);
}
.summary-label {
  font-size: 22rpx;
  color: var(--text-3);
  letter-spacing: 0.04em;
}
.summary-number {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  margin-top: 8rpx;
}
.summary-number .num {
  font-size: 96rpx;
  line-height: 0.98;
  font-weight: 700;
  letter-spacing: -0.05em;
  color: var(--mint);
}
.summary-number .unit {
  font-size: 24rpx;
  color: var(--text-3);
  padding-bottom: 14rpx;
}
.summary-dots {
  display: flex;
  gap: 10rpx;
  margin-top: 28rpx;
}
.summary-dots .dot {
  flex: 1;
  height: 12rpx;
  border-radius: 999rpx;
  background: var(--seg-off);
}
.summary-dots .dot.on {
  background: var(--seg-on);
}
.summary-foot {
  display: flex;
  justify-content: space-between;
  font-size: 20rpx;
  color: var(--text-3);
  margin-top: 16rpx;
}
.firstuse-hint {
  margin-top: 18rpx;
  padding: 16rpx 20rpx;
  border-radius: 18rpx;
  background: var(--pending-bg);
  color: var(--pending-ink);
  font-size: 22rpx;
  line-height: 1.6;
}

/* 日项列表 */
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 40rpx 4rpx 18rpx;
}
.sh-title {
  font-size: 25rpx;
  font-weight: 650;
  color: var(--text);
}
.sh-sub {
  font-size: 20rpx;
  color: var(--text-3);
}
.day-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.day-row {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
  background: var(--card);
  border: 1rpx solid var(--card-line);
  border-radius: 30rpx;
  padding: 24rpx 24rpx 22rpx;
  box-shadow: var(--card-shadow);
}
.day-row.today {
  border-color: var(--mint);
  box-shadow: 0 0 0 3rpx var(--mint-soft);
}
.day-date {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
  width: 84rpx;
  flex: 0 0 auto;
}
.day-num {
  font-size: 38rpx;
  line-height: 1;
  font-weight: 650;
  letter-spacing: -0.03em;
  color: var(--text);
}
.day-week {
  font-size: 19rpx;
  color: var(--text-3);
  margin-top: 8rpx;
}
.day-main {
  flex: 1;
  min-width: 0;
}
.day-times {
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.35;
  color: var(--text);
}
.day-times .empty {
  color: var(--text-3);
  font-weight: 500;
}
.day-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
}
.tag {
  font-size: 18rpx;
  line-height: 1.5;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: var(--tag-bg);
  color: var(--tag-ink);
}
.tag.good {
  background: var(--ok-bg);
  color: var(--ok-ink);
}
.tag.warn {
  background: var(--bad-bg);
  color: var(--bad-ink);
}
.day-reason {
  display: block;
  font-size: 19rpx;
  line-height: 1.5;
  color: var(--bad-ink);
  margin-top: 8rpx;
}
.day-edit {
  display: block;
  font-size: 19rpx;
  color: var(--text-3);
  margin-top: 8rpx;
}
.day-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex: 0 0 auto;
}
.badge {
  font-size: 19rpx;
  font-weight: 600;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  white-space: nowrap;
}
.badge.ok {
  background: var(--ok-bg);
  color: var(--ok-ink);
}
.badge.bad {
  background: var(--bad-bg);
  color: var(--bad-ink);
}
.badge.pending {
  background: var(--pending-bg);
  color: var(--pending-ink);
}
.badge.muted {
  background: var(--muted-bg);
  color: var(--muted-ink);
}
.badge.future {
  background: transparent;
  color: var(--future-ink);
  font-weight: 500;
  padding-right: 0;
}
.today-flag {
  font-size: 17rpx;
  letter-spacing: 0.12em;
  color: var(--mint);
}

/* 规则说明 */
.rule-card {
  margin-top: 30rpx;
  padding: 24rpx 28rpx;
  border: 1rpx dashed var(--chip-line);
  border-radius: 28rpx;
  background: var(--chip);
}
.rule-title {
  display: block;
  font-size: 21rpx;
  font-weight: 650;
  color: var(--text-2);
  margin-bottom: 10rpx;
}
.rule-text {
  display: block;
  font-size: 20rpx;
  line-height: 1.7;
  color: var(--text-3);
}
.readonly-note {
  font-size: 19rpx;
  color: var(--text-3);
  text-align: center;
  margin-top: 28rpx;
  line-height: 1.6;
}
