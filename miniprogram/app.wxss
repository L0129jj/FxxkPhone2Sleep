/* 全局样式：暖白背景 + 深色文字 */
page {
  background: #f7f5f1;
  color: #161615;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC',
    'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  -webkit-tap-highlight-color: transparent;
}

view,
text {
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border: 1rpx solid rgba(22, 22, 21, 0.08);
  border-radius: 32rpx;
  box-shadow: 0 18rpx 44rpx -40rpx rgba(22, 22, 21, 0.5);
}

/* 页面顶部自定义导航占位 */
.nav-holder {
  width: 100%;
}

/* 安全区 */
.safe-bottom {
  padding-bottom: calc(env(safe-area-inset-bottom) + 24rpx);
}
