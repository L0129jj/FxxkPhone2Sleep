.tg-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(12, 12, 11, 0.4);
  z-index: 40;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.24s ease, visibility 0.24s;
}
.tg-mask.open {
  opacity: 1;
  visibility: visible;
}

.tg-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 45;
  background: #fbfaf7;
  border-radius: 44rpx 44rpx 0 0;
  padding: 20rpx 40rpx 24rpx;
  transform: translateY(103%);
  visibility: hidden;
  transition: transform 0.32s cubic-bezier(0.22, 0.85, 0.3, 1), visibility 0.32s;
  box-shadow: 0 -40rpx 100rpx -40rpx rgba(0, 0, 0, 0.45);
}
.tg-sheet.open {
  transform: translateY(0);
  visibility: visible;
}

.grabber {
  width: 64rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #d9d5cc;
  margin: 0 auto 32rpx;
}

.tg-title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: -0.02em;
}
.tg-desc {
  display: block;
  font-size: 22rpx;
  line-height: 1.6;
  color: #8b8982;
  margin-top: 10rpx;
}

.tg-info {
  margin-top: 24rpx;
  background: #ffffff;
  border: 1rpx solid rgba(22, 22, 21, 0.09);
  border-radius: 20rpx;
  padding: 4rpx 24rpx;
}
.tg-info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
}
.tg-info-row + .tg-info-row {
  border-top: 1rpx solid rgba(22, 22, 21, 0.06);
}
.tg-info-label {
  font-size: 24rpx;
  color: #8b8982;
}
.tg-info-value {
  font-size: 28rpx;
  font-weight: 650;
}
.tg-info-value.muted {
  color: #a9a69e;
  font-weight: 500;
}

.tg-switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 28rpx 4rpx 8rpx;
}
.tg-switch-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
}
.tg-switch-desc {
  display: block;
  font-size: 20rpx;
  color: #8b8982;
  margin-top: 4rpx;
}
.tg-switch {
  width: 88rpx;
  height: 52rpx;
  border-radius: 999rpx;
  background: #dedad1;
  position: relative;
  transition: background 0.22s;
  flex: 0 0 auto;
}
.tg-switch-dot {
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.18);
  transition: transform 0.22s cubic-bezier(0.2, 0.8, 0.3, 1);
}
.tg-switch.on {
  background: #18a558;
}
.tg-switch.on .tg-switch-dot {
  transform: translateX(36rpx);
}

.tg-time-wrap {
  margin-top: 20rpx;
  background: #ffffff;
  border: 1rpx solid rgba(22, 22, 21, 0.09);
  border-radius: 24rpx;
  padding: 14rpx 24rpx;
  display: flex;
  justify-content: center;
}
.tg-time-wrap.dis {
  opacity: 0.45;
}
.tg-time {
  font-size: 60rpx;
  font-weight: 650;
  letter-spacing: -0.02em;
  font-variant-numeric: tabular-nums;
  line-height: 1.25;
}

.tg-effective {
  margin-top: 22rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: #eef4ff;
  color: #3d5a95;
  font-size: 22rpx;
  line-height: 1.65;
}
.tg-effective.locked {
  background: #fdf4e6;
  color: #8a6114;
}
.tg-error {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #c03427;
  line-height: 1.55;
  background: #fff0ee;
  border-radius: 16rpx;
  padding: 14rpx 20rpx;
}

.tg-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 30rpx;
}
.tg-btn {
  height: 88rpx;
  border-radius: 26rpx;
  font-size: 28rpx;
  font-weight: 650;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tg-btn.ghost {
  flex: 1;
  background: #efede7;
  color: #45443f;
}
.tg-btn.primary {
  flex: 1.4;
  background: #161615;
  color: #ffffff;
}
.tg-btn.primary.dis {
  opacity: 0.55;
}
.press {
  transform: scale(0.98);
  opacity: 0.9;
}
