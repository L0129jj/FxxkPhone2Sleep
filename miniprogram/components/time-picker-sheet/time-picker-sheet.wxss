/* 主题变量（组件样式隔离，需自带一份） */
.theme-light {
  --sheet-bg: #fbfaf7;
  --text: #17171c;
  --text-2: #4e4b44;
  --text-3: #6e6960;
  --card: #ffffff;
  --card-line: rgba(23, 23, 28, 0.09);
  --divider: rgba(23, 23, 28, 0.06);
  --grabber: #d9d5cc;
  --btn-primary-bg: #17171c;
  --btn-primary-ink: #ffffff;
  --btn-ghost-bg: #efede7;
  --btn-ghost-ink: #45443f;
  --bad-bg: #fdf0ed;
  --bad-ink: #b8382b;
}
.theme-dark {
  --sheet-bg: #11141f;
  --text: #f4f6fb;
  --text-2: #aab1c4;
  --text-3: #7e8598;
  --card: rgba(255, 255, 255, 0.06);
  --card-line: rgba(255, 255, 255, 0.12);
  --divider: rgba(255, 255, 255, 0.08);
  --grabber: rgba(255, 255, 255, 0.22);
  --btn-primary-bg: #f4f6fb;
  --btn-primary-ink: #0a0c14;
  --btn-ghost-bg: rgba(255, 255, 255, 0.09);
  --btn-ghost-ink: #c6ccda;
  --bad-bg: rgba(255, 155, 138, 0.14);
  --bad-ink: #ffc3b8;
}

.tp-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(12, 12, 11, 0.4);
  z-index: 40;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.24s ease, visibility 0.24s;
}
.tp-mask.open {
  opacity: 1;
  visibility: visible;
}

.tp-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 45;
  background: var(--sheet-bg);
  color: var(--text);
  border-radius: 44rpx 44rpx 0 0;
  padding: 20rpx 40rpx 24rpx;
  transform: translateY(103%);
  visibility: hidden;
  transition: transform 0.32s cubic-bezier(0.22, 0.85, 0.3, 1), visibility 0.32s;
  box-shadow: 0 -40rpx 100rpx -40rpx rgba(0, 0, 0, 0.45);
}
.tp-sheet.open {
  transform: translateY(0);
  visibility: visible;
}

.grabber {
  width: 64rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--grabber);
  margin: 0 auto 32rpx;
}

.tp-title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--text);
}
.tp-desc {
  display: block;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--text-3);
  margin-top: 10rpx;
}

.tp-seg {
  display: flex;
  gap: 12rpx;
  margin-top: 26rpx;
  background: var(--card);
  border: 1rpx solid var(--card-line);
  border-radius: 20rpx;
  padding: 8rpx;
}
.tp-seg-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-2);
  padding: 14rpx 0;
  border-radius: 14rpx;
}
.tp-seg-item.on {
  background: var(--btn-primary-bg);
  color: var(--btn-primary-ink);
}
.tp-seg-item.dis {
  opacity: 0.45;
}

.tp-time-wrap {
  margin-top: 22rpx;
  background: var(--card);
  border: 1rpx solid var(--card-line);
  border-radius: 24rpx;
  padding: 16rpx 24rpx 12rpx;
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 16rpx;
}
.tp-time {
  font-size: 68rpx;
  font-weight: 650;
  letter-spacing: -0.02em;
  font-variant-numeric: tabular-nums;
  line-height: 1.2;
  color: var(--text);
}
.tp-time-unit {
  font-size: 20rpx;
  color: var(--text-3);
}

.tp-error {
  font-size: 22rpx;
  color: var(--bad-ink);
  line-height: 1.55;
  margin-top: 16rpx;
  background: var(--bad-bg);
  border-radius: 16rpx;
  padding: 14rpx 20rpx;
}
.tp-hint {
  display: block;
  font-size: 20rpx;
  line-height: 1.6;
  color: var(--text-3);
  margin-top: 16rpx;
}

.tp-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}
.tp-btn {
  height: 88rpx;
  border-radius: 26rpx;
  font-size: 28rpx;
  font-weight: 650;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tp-btn.ghost {
  flex: 1;
  background: var(--btn-ghost-bg);
  color: var(--btn-ghost-ink);
}
.tp-btn.primary {
  flex: 1.4;
  background: var(--btn-primary-bg);
  color: var(--btn-primary-ink);
}
.tp-btn.primary.dis {
  opacity: 0.55;
}
.press {
  transform: scale(0.98);
  opacity: 0.9;
}

/* 组件样式隔离，app.wxss 的 .safe-bottom 不生效，需自带一份 */
.safe-bottom {
  padding-bottom: calc(env(safe-area-inset-bottom) + 24rpx);
}
