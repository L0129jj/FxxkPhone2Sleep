.tp-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(12, 12, 11, 0.4);
  z-index: 40;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.24s ease, visibility 0.24s;
}
.tp-mask.open {
  opacity: 1;
  visibility: visible;
}

.tp-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 45;
  background: #fbfaf7;
  border-radius: 44rpx 44rpx 0 0;
  padding: 20rpx 40rpx 24rpx;
  transform: translateY(103%);
  visibility: hidden;
  transition: transform 0.32s cubic-bezier(0.22, 0.85, 0.3, 1), visibility 0.32s;
  box-shadow: 0 -40rpx 100rpx -40rpx rgba(0, 0, 0, 0.45);
}
.tp-sheet.open {
  transform: translateY(0);
  visibility: visible;
}

.grabber {
  width: 64rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #d9d5cc;
  margin: 0 auto 32rpx;
}

.tp-title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: -0.02em;
}
.tp-desc {
  display: block;
  font-size: 22rpx;
  line-height: 1.6;
  color: #8b8982;
  margin-top: 10rpx;
}

.tp-seg {
  display: flex;
  gap: 12rpx;
  margin-top: 26rpx;
  background: #ffffff;
  border: 1rpx solid rgba(22, 22, 21, 0.09);
  border-radius: 20rpx;
  padding: 8rpx;
}
.tp-seg-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #45443f;
  padding: 14rpx 0;
  border-radius: 14rpx;
}
.tp-seg-item.on {
  background: #161615;
  color: #ffffff;
}
.tp-seg-item.dis {
  color: #c9c6bf;
}

.tp-time-wrap {
  margin-top: 22rpx;
  background: #ffffff;
  border: 1rpx solid rgba(22, 22, 21, 0.09);
  border-radius: 24rpx;
  padding: 16rpx 24rpx 12rpx;
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 16rpx;
}
.tp-time {
  font-size: 68rpx;
  font-weight: 650;
  letter-spacing: -0.02em;
  font-variant-numeric: tabular-nums;
  line-height: 1.2;
}
.tp-time-unit {
  font-size: 20rpx;
  color: #a9a69e;
}

.tp-error {
  font-size: 22rpx;
  color: #c03427;
  line-height: 1.55;
  margin-top: 16rpx;
  background: #fff0ee;
  border-radius: 16rpx;
  padding: 14rpx 20rpx;
}
.tp-hint {
  display: block;
  font-size: 20rpx;
  line-height: 1.6;
  color: #a9a69e;
  margin-top: 16rpx;
}

.tp-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}
.tp-btn {
  height: 88rpx;
  border-radius: 26rpx;
  font-size: 28rpx;
  font-weight: 650;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tp-btn.ghost {
  flex: 1;
  background: #efede7;
  color: #45443f;
}
.tp-btn.primary {
  flex: 1.4;
  background: #161615;
  color: #ffffff;
}
.tp-btn.primary.dis {
  opacity: 0.55;
}
.press {
  transform: scale(0.98);
  opacity: 0.9;
}
